# ---- Required ----
DATABASE_URL="postgresql://cadence:cadence@localhost:5432/cadence?schema=public"
# openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
# 32 bytes, base64 encoded: openssl rand -base64 32  (encrypts integration secrets — keep it safe and stable)
APP_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTES"

# ---- HTTP ----
PORT=3000
# Comma-separated allowed browser origins; the first one is used in password-reset links.
WEB_ORIGIN="http://localhost:4200"
# Public base URL of the API, used to show webhook URLs (must be reachable by Jira/GitHub/...).
PUBLIC_API_URL="http://localhost:3000/api"
# Express "trust proxy" setting, so audit logs record the real client IP behind a load balancer.
TRUST_PROXY="loopback"
# Secure cookies: defaults to true when NODE_ENV=production.
# COOKIE_SECURE=true

# ---- Sessions ----
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14

# ---- First launch ----
DEFAULT_ADMIN_EMAIL="admin@cadence.local"
DEFAULT_ADMIN_NAME="Administrator"
# Require the one-time setup token printed in the log (defaults to true when NODE_ENV=production).
# SETUP_TOKEN_REQUIRED=true
# Optionally pin the token instead of generating one:
# SETUP_TOKEN=

# ---- Sync ----
# Nightly sync (cron, server timezone). "off" disables it.
SYNC_CRON="0 2 * * *"
# With Redis, syncs run on a BullMQ queue (schedule fires once across instances).
# REDIS_URL="redis://localhost:6379"
# Set to false on API instances that should only enqueue (run workers separately).
# SYNC_WORKER=true
# SYNC_CONCURRENCY=2
# Quiet period before a burst of webhooks triggers one re-sync.
WEBHOOK_DEBOUNCE_MS=60000

# ---- E-mail (password resets) ----
# Without SMTP_URL, e-mails are written to the API log.
# SMTP_URL="smtps://user:pass@smtp.cadence.local:465"
# MAIL_FROM="Cadence <no-reply@cadence.local>"

# ---- Rate limits (requests per minute per IP) ----
# THROTTLE_LIMIT=300
# THROTTLE_AUTH_LIMIT=10
